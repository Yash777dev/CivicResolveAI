# CivicResolve AI Environment Configuration Example
# Copy this file to .env in your root and backend directories

# Environment & Debugging
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=civicresolve-secret-key-change-in-production-min-32-chars

# Database Configuration
# Default to SQLite local storage (as requested for local zero-dependency run)
DATABASE_URL=sqlite:///civicresolve.db
# Optional PostgreSQL (uncomment if using PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicresolve_db

# JWT Security
JWT_SECRET_KEY=civicresolve-jwt-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Configuration
UPLOAD_FOLDER=storage/uploads
MAX_CONTENT_LENGTH=10485760 # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf

# Explainable Priority Engine Settings
PRIORITY_ENGINE_VERSION=1.0.0
SIMILARITY_THRESHOLD=0.65

# SLA Targets (in hours)
DEFAULT_ACKNOWLEDGEMENT_SLA_HOURS=24
DEFAULT_RESOLUTION_SLA_HOURS=72
